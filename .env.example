# Copy to .env.local and fill in.

# MongoDB connection string (MongoDB Atlas or a local server).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/atithya

# Two different random secrets, at least 32 characters each.
# Generate one with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional. Seconds a simulated order spends in each status (default 20).
ORDER_STEP_SECONDS=20
